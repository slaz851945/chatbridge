{
  "name": "chatbridge",
  "version": "0.1.0",
  "description": "Pont portable entre sessions LLM — export/import de longs chats (DeepSeek, ChatGPT).",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Équipe ChatBridge",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-monkey": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
